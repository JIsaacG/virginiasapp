# Plantilla del .env del sitio CEEVS. Copiar como ".env" y rellenar.
# El .env real NUNCA se sube a Git (ver .gitignore) ni se sirve por web (.htaccess).
#
# Solo se leen las claves CEEVS_DB_*. Orden de prioridad, de menor a mayor:
#   .env  →  archivo escrito por el panel  →  variables de entorno del servidor
# Es decir: si algún día configuras la base desde el panel (pestaña 📋 →
# "🗄️ Base de datos"), eso manda sobre lo que quede escrito aquí.
#
# En Hostinger, este archivo se borra en cada publicación del sitio si vive en
# la raíz. Para que sobreviva, súbelo también a la carpeta privada hermana de
# public_html (la misma donde está VIRGINIASAPP): ahí se busca primero.

CEEVS_DB_HOST=localhost
CEEVS_DB_PORT=3306
CEEVS_DB_NAME=
CEEVS_DB_USER=
# Entre comillas: las contraseñas del hosting suelen llevar # y otros símbolos.
CEEVS_DB_PASS=""
CEEVS_DB_CHARSET=utf8mb4
