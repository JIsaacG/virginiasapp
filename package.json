{
  "name": "ceevs-website",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio institucional del Centro Educativo Evangélico Virginia Sapp",
  "scripts": {
    "postinstall": "patch-package",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:lighthouse": "lhci autorun",
    "seo:audit": "npm run seo:check && npm run seo:lighthouse",
    "seo:production": "node scripts/seo-production-check.mjs",
    "check:js": "node scripts/check-js-syntax.mjs",
    "check:php": "node scripts/check-php-syntax.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:pages": "python generate-pages.py",
    "verify": "node scripts/verify.mjs",
    "verify:low": "node scripts/verify.mjs --level=low",
    "verify:medium": "node scripts/verify.mjs --level=medium",
    "verify:high": "node scripts/verify.mjs --level=high"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "@lhci/cli": {
      "lighthouse": "13.4.1"
    }
  }
}
